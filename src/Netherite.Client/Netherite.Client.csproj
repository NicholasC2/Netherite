<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Netherite.Client</RootNamespace>
    <AssemblyName>Netherite.Client</AssemblyName>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <RuntimeIdentifiers>
      win-x64;linux-x64;osx-x64;osx-arm64
    </RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetherLib\NetherLib.csproj" />
    <ProjectReference Include="..\Netherite.Server\Netherite.Server.csproj" />

    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
  </ItemGroup>

</Project>
